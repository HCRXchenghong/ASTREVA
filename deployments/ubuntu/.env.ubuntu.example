SITE_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
SERVICE_DOMAIN=service.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=customer_service
POSTGRES_USER=customer_service
POSTGRES_PASSWORD=change-me-long-random-database-password
DATABASE_URL=postgres://customer_service:change-me-long-random-database-password@postgres:5432/customer_service?sslmode=disable
REDIS_ADDR=redis:6379

DATA_ENCRYPTION_KEY=change-me-at-least-32-random-characters
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password-12-plus
AGENT_BOOTSTRAP_PASSWORD=change-me-agent-password-12-plus
SERVICEBRIDGE_ADMIN_ACCOUNT=superadmin
ADMIN_2FA_SESSION_SECRET=change-me-admin-session-secret-24-plus
ADMIN_2FA_ISSUER=星渡官网账号
ADMIN_2FA_SESSION_TTL_MS=43200000
REBUILD_WEBHOOK_SECRET=change-me-rebuild-secret-16-plus
REBUILD_WEBHOOK_PORT=8787
METRICS_BEARER_TOKEN=change-me-metrics-token-24-plus
# admin-server 与 Go 引擎之间的服务间令牌（访客画像转发 / AI 供应商内部读取）
INTERNAL_API_TOKEN=change-me-internal-api-token-32-plus
# 可选的预览 Cookie 父域；默认自动取 ADMIN_DOMAIN/SITE_DOMAIN 的公共父域
PREVIEW_COOKIE_DOMAIN=
# 首次初始化令牌；生产必须显式设置（scripts/ubuntu-one-click.sh 会自动生成并打印，不写入容器日志）
ADMIN_SETUP_TOKEN=

CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com,https://service.example.com
FRAME_ANCESTORS=https://www.example.com
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
SECURITY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_TYPE=chat_completions

UPLOAD_DRIVER=local
ADMIN_MEDIA_DRIVER=s3
# 单机部署可设为 true 使用本地卷；多机/商业化推荐 s3
ADMIN_ALLOW_LOCAL_MEDIA=false
ADMIN_S3_KEY_PREFIX=site-admin
ADMIN_S3_SERVER_SIDE_ENCRYPTION=
UPLOAD_PUBLIC_BASE_URL=https://service.example.com
UPLOAD_MAX_BYTES=10485760

# 后台素材使用的对象存储必须让“服务器”和“管理员浏览器”都能访问：
# - 服务器用 S3_ENDPOINT 做 HeadBucket / 写入校验；
# - 预签名直传时浏览器会直接 PUT 到 S3_ENDPOINT，所以它必须是外网可达的 https 地址。
# 生产推荐直接使用 Cloudflare R2 / 阿里云 OSS / AWS S3 等外部对象存储。
# 仓库内置的 MinIO 只监听宿主机回环（MINIO_HOST_PORT），仅适合本机验证，不要用于生产素材直传。
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=uploads
S3_PUBLIC_BASE_URL=

# 内置 MinIO 的根凭证（compose 必填；使用外部对象存储时也应填写为强随机值，避免空口令容器）。
MINIO_ROOT_USER=astreva-minio
MINIO_ROOT_PASSWORD=change-me-minio-password-16-plus
# 宿主机调试端口，默认只绑定 127.0.0.1
MINIO_HOST_PORT=127.0.0.1:9100

# ---------------------------------------------------------------- 监控（profile: monitoring）
# 仅在显式启用监控 profile 时使用：
#   docker compose --env-file deployments/ubuntu/.env.ubuntu --profile monitoring up -d
#
# Prometheus 抓取 /metrics 用的 Bearer token 复用上面的 METRICS_BEARER_TOKEN
# （compose 会把同一个值同时注入 Go 后端与 admin-server，因此这里不需要第二份）。
# Prometheus 数据保留时间（Go duration 语法：15d / 30d / 720h）。
PROMETHEUS_RETENTION=15d
# Grafana 初始管理员账号密码。首次启动后请立即改密；不要使用示例值。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
# Grafana 对外根地址（默认仅回环访问，通常不需要改）。
GRAFANA_ROOT_URL=http://127.0.0.1:3000
# 宿主机监听端口，默认只绑定 127.0.0.1（如需外部访问请用 SSH 隧道，不要直接暴露公网）。
PROMETHEUS_HOST_PORT=127.0.0.1:9090
GRAFANA_HOST_PORT=127.0.0.1:3000
