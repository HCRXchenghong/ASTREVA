---
/**
 * Page-width container. Every section should use this instead of repeating
 * `max-w-7xl mx-auto px-6` by hand (the old frontend repeated it 15 times).
 */
type Props = {
  class?: string;
  size?: 'wide' | 'narrow';
};

const { class: className = '', size = 'wide' } = Astro.props;
const width = size === 'narrow' ? 'max-w-4xl' : 'max-w-7xl';
---

<div class:list={['mx-auto px-6', width, className]}>
  <slot />
</div>
