---
/**
 * Vertical rhythm + background tone for a page section.
 * Tones map to the brand tokens, so no page needs to spell out hex values.
 */
type Props = {
  id?: string;
  tone?: 'white' | 'muted' | 'brand' | 'navy';
  spacing?: 'normal' | 'compact';
  class?: string;
};

const { id, tone = 'white', spacing = 'normal', class: className = '' } = Astro.props;

const tones = {
  white: 'bg-white text-ink-900',
  muted: 'bg-surface-50 text-ink-900',
  brand: 'bg-brand-800 text-white',
  navy: 'bg-navy-900 text-white'
};
---

<section
  id={id}
  class:list={['scroll-mt-24', spacing === 'compact' ? 'py-12 md:py-16' : 'py-24', tones[tone], className]}
>
  <slot />
</section>
