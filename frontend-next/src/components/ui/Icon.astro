---
/**
 * Curated line-icon set (24x24, stroke, currentColor).
 *
 * Inline SVG on purpose: no icon font, no runtime JS, no extra request, and the
 * stroke weight stays consistent across every CMS-provided icon.
 */
import type { IconName } from '../../lib/icons';

type Props = {
  name: IconName;
  class?: string;
  /** Decorative by default. Pass a label only when the icon carries meaning. */
  label?: string;
  strokeWidth?: number;
};

const { name, class: className = 'h-6 w-6', label, strokeWidth = 1.7 } = Astro.props;

const paths: Record<IconName, string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  arrowLeft: '<path d="M19 12H5"/><path d="m11 6-6 6 6 6"/>',
  download: '<path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/>',
  zap: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>',
  shieldCheck: '<path d="M12 3 5 6v6c0 4.4 3 7.4 7 9 4-1.6 7-4.6 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>',
  shield: '<path d="M12 3 5 6v6c0 4.4 3 7.4 7 9 4-1.6 7-4.6 7-9V6l-7-3z"/>',
  truck:
    '<path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/>',
  leaf: '<path d="M20 4C11 4 4 9 4 16c0 2.2 1.4 4 3.6 4C15 20 20 13 20 4z"/><path d="M4.5 19.5C7 14 11 10.5 15 8.5"/>',
  droplet: '<path d="M12 3s6 6.4 6 10.4A6 6 0 0 1 6 13.4C6 9.4 12 3 12 3z"/>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9l-3.8 3.8z"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.1 9.2a2.9 2.9 0 0 1 5.6 1c0 2-2.9 2.4-2.9 4"/><path d="M12 17.5h.01"/>',
  phone:
    '<path d="M6.6 3h3l1.5 4-2 1.4a12.5 12.5 0 0 0 6.5 6.5l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5z"/><path d="m3 13 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/>',
  box: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>',
  play: '<path d="M8 5v14l11-7z"/>',
  star: '<path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.3l6.1-.7z"/>',
  building:
    '<path d="M4 21V6l8-3 8 3v15"/><path d="M9 21v-6h6v6"/><path d="M8 9h1M8 12h1M15 9h1M15 12h1"/>',
  circle: '<circle cx="12" cy="12" r="8.5"/>'
};

const inner = paths[name] ?? paths.circle;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {label && <title>{label}</title>}
  <Fragment set:html={inner} />
</svg>
