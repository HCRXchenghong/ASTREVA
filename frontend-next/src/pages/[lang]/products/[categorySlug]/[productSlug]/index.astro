---
import ProductDetailView from '../../../../../views/ProductDetailView.astro';
import { getContent, hasTranslation } from '../../../../../lib/content';
import { PREFIXED_LOCALES, type SiteLocale } from '../../../../../lib/i18n';
import type { Category, Product } from '../../../../../lib/types';

export async function getStaticPaths() {
  const paths: Array<{
    params: { lang: SiteLocale; categorySlug: string; productSlug: string };
    props: { product: Product; category: Category };
  }> = [];
  for (const lang of PREFIXED_LOCALES) {
    if (!(await hasTranslation(lang))) continue;
    const content = await getContent(lang);
    for (const product of content.products) {
      const category = content.categories.find((item) => item.slug === product.categorySlug);
      if (!category) continue;
      paths.push({
        params: { lang, categorySlug: product.categorySlug, productSlug: product.slug },
        props: { product, category }
      });
    }
  }
  return paths;
}

const { lang } = Astro.params as { lang: SiteLocale };
const content = await getContent(lang);
const { product, category } = Astro.props;
---

<ProductDetailView content={content} locale={lang} product={product} category={category} />
