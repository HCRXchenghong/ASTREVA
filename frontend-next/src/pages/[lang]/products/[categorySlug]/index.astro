---
import CategoryView from '../../../../views/CategoryView.astro';
import { getContent, hasTranslation } from '../../../../lib/content';
import { PREFIXED_LOCALES, type SiteLocale } from '../../../../lib/i18n';
import type { Category } from '../../../../lib/types';

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: SiteLocale; categorySlug: string }; props: { category: Category } }> = [];
  for (const lang of PREFIXED_LOCALES) {
    if (!(await hasTranslation(lang))) continue;
    const content = await getContent(lang);
    for (const category of content.categories) {
      paths.push({ params: { lang, categorySlug: category.slug }, props: { category } });
    }
  }
  return paths;
}

const { lang } = Astro.params as { lang: SiteLocale };
const content = await getContent(lang);
const { category } = Astro.props;
---

<CategoryView content={content} locale={lang} category={category} />
