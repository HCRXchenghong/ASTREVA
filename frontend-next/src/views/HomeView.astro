---
import VideoModal from '../components/VideoModal';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { featuredProducts } from '../lib/content';
import { localePath, localizeHref, type SiteLocale } from '../lib/i18n';
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale };

const { content, locale } = Astro.props;
const home = content.home;
const featured = featuredProducts(content, 3);
const localHref = (path: string) => localizeHref(locale, path) as string;
---

<BaseLayout content={content} seo={home.seo} path={localePath(locale, '/')} locale={locale}>
  <div class="w-full">
    <div id="home-hero" class="relative flex h-screen min-h-[700px] items-center overflow-hidden bg-navy-900 scroll-mt-24">
      {
        home.hero.backgroundVideo ? (
          <video
            class="pointer-events-none absolute inset-0 h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster={home.hero.backgroundImage || undefined}
            aria-hidden="true"
          >
            <source src={home.hero.backgroundVideo} type="video/mp4" />
          </video>
        ) : home.hero.backgroundImage ? (
          <div
            class="absolute inset-0 bg-cover bg-center bg-no-repeat"
            style={`background-image:url('${home.hero.backgroundImage}')`}
          />
        ) : (
          <div class="absolute inset-0 bg-linear-to-br from-slate-900 via-brand-900 to-slate-800" />
        )
      }
      <div class="absolute inset-0 bg-linear-to-r from-brand-950/95 via-brand-900/80 to-transparent mix-blend-multiply" />
      <div class="absolute inset-0 bg-navy-950/40" />
      <Container class="relative z-10 w-full pt-16">
        <p class="mb-4 text-lg font-medium tracking-wide text-brand-300">{home.hero.eyebrow}</p>
        <h1 class="mb-6 text-5xl font-extrabold tracking-tight text-white md:text-7xl">
          {home.hero.title}<span class="relative -top-4 align-top text-[0.4em]">{home.hero.trademark}</span>
        </h1>
        <p class="mb-12 max-w-2xl text-xl font-light text-gray-200 md:text-2xl">{home.hero.subtitle}</p>
        <VideoModal
          client:only="react"
          primaryLabel={home.hero.primaryCta}
          primaryHref={localHref(home.hero.primaryHref)}
          secondaryLabel={home.hero.secondaryCta}
          videoUrl={home.hero.videoUrl}
          videoTitle={home.hero.videoTitle}
          previewLabel={home.hero.videoPreviewLabel}
          openExternalLabel={home.hero.videoOpenExternalLabel}
          closeLabel={home.hero.videoCloseLabel}
        />
      </Container>
    </div>

    <Section id="home-products" tone="muted">
      <Container>
        <SectionHeading
          title={home.featuredProducts.title}
          description={home.featuredProducts.description}
          class="mb-16"
        />
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {
            featured.map((item) => (
              <a
                href={localHref(`/products/${item.categorySlug}/${item.slug}/`)}
                class="group overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-lg transition-shadow hover:shadow-xl"
              >
                <div class="h-64 overflow-hidden bg-slate-100">
                  {item.coverImage ? (
                    <img
                      src={item.coverImage}
                      alt={item.name}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                  ) : (
                    <div
                      role="img"
                      aria-label={item.name}
                      class="grid h-full w-full place-items-center bg-linear-to-br from-slate-100 via-slate-200 to-slate-300 text-5xl font-black text-slate-400"
                    >
                      <span aria-hidden="true">◇</span>
                    </div>
                  )}
                </div>
                <div class="p-8">
                  <h3 class="mb-3 text-xl font-bold text-gray-800">{item.name}</h3>
                  <p class="mb-6 line-clamp-2 text-gray-600">{item.summary}</p>
                  <span class="flex items-center gap-1 font-semibold text-brand-500 transition-all group-hover:gap-3">
                    {home.featuredProducts.linkLabel}
                    <span aria-hidden="true">{home.featuredProducts.linkIcon}</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </Container>
    </Section>

    <Section id="home-product-intro">
      <Container class="flex flex-col items-center gap-16 md:flex-row">
        <div class="md:w-1/2">
          <h2 class="mb-6 text-4xl font-extrabold text-brand-800">{home.productIntro.title}</h2>
          <p class="mb-6 text-lg leading-relaxed text-gray-600">{home.productIntro.description}</p>
          <ul class="mb-8 space-y-4">
            {
              home.productIntro.bullets.map((text) => (
                <li class="flex items-center gap-3 font-medium text-gray-700">
                  <span class="text-2xl leading-none text-brand-500" aria-hidden="true">
                    {home.productIntro.bulletIcon}
                  </span>
                  {text}
                </li>
              ))
            }
          </ul>
          <Button href={localHref(home.productIntro.ctaHref)} variant="outline">
            {home.productIntro.ctaLabel}
          </Button>
        </div>
        <div class="relative md:w-1/2">
          <div class="relative z-10 aspect-square overflow-hidden rounded-3xl border border-gray-100 shadow-2xl md:aspect-[4/3]">
            {home.productIntro.image ? (
              <img src={home.productIntro.image} alt={home.productIntro.title} class="h-full w-full object-cover" />
            ) : (
              <div
                role="img"
                aria-label={home.productIntro.title}
                class="grid h-full w-full place-items-center bg-linear-to-br from-slate-100 via-slate-200 to-slate-300 text-6xl font-black text-slate-400"
              >
                <span aria-hidden="true">◇</span>
              </div>
            )}
          </div>
        </div>
      </Container>
    </Section>

    <Section id="home-advantages" tone="brand">
      <Container>
        <SectionHeading
          title={home.advantagesIntro.title}
          description={home.advantagesIntro.description}
          tone="dark"
          class="mb-16"
        />
        <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
          {
            home.advantages.map((item) => (
              <div class="rounded-2xl border border-blue-400/20 bg-brand-750 p-8 transition-transform hover:-translate-y-2">
                <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl font-black text-brand-300">
                  {item.icon}
                </div>
                <h3 class="mb-3 text-xl font-bold">{item.title}</h3>
                <p class="text-sm leading-relaxed text-blue-100">{item.description}</p>
              </div>
            ))
          }
        </div>
      </Container>
    </Section>

    {
      home.testimonials.length > 0 && (
        <Section id="home-testimonials" tone="muted">
          <Container>
            <h2 class="mb-16 text-center text-4xl font-extrabold text-brand-800">{home.testimonialsTitle}</h2>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {home.testimonials.map((review) => (
                <div class="relative rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition-shadow hover:shadow-md">
                  <span class="absolute right-6 top-6 font-serif text-5xl leading-none text-blue-100" aria-hidden="true">
                    “
                  </span>
                  <p class="relative z-10 mb-6 italic text-gray-600">"{review.text}"</p>
                  <div class="mt-auto flex items-center gap-4">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-500/10 text-lg font-bold text-brand-500">
                      {review.name[0]}
                    </div>
                    <div>
                      <h4 class="font-bold text-gray-900">{review.name}</h4>
                      <p class="text-xs text-gray-500">{review.role}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </Container>
        </Section>
      )
    }

    <Section id="home-cta" spacing="compact">
      <Container size="narrow">
        <div class="relative overflow-hidden rounded-3xl border border-blue-400/30 bg-linear-to-br from-brand-800 to-brand-500 p-12 text-center text-white shadow-2xl md:p-20">
          {home.cta.backgroundImage && (
            <div
              class="absolute left-0 top-0 h-full w-full bg-cover opacity-10 mix-blend-overlay"
              style={`background-image:url('${home.cta.backgroundImage}')`}
            />
          )}
          <div class="relative z-10">
            <h2 class="mb-6 text-4xl font-extrabold md:text-5xl">{home.cta.title}</h2>
            <p class="mx-auto mb-10 max-w-2xl text-xl text-blue-100">{home.cta.description}</p>
            <div class="flex flex-col justify-center gap-4 sm:flex-row">
              <Button href={localHref(home.cta.primaryHref)} variant="white" size="lg">
                {home.cta.primaryLabel}
              </Button>
              <Button href={localHref(home.cta.secondaryHref)} variant="ghost" size="lg">
                {home.cta.secondaryLabel}
              </Button>
            </div>
          </div>
        </div>
      </Container>
    </Section>
  </div>
</BaseLayout>
