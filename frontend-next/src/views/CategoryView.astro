---
import InnerPageHero from '../components/InnerPageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { productsForCategory } from '../lib/content';
import { localePath, localizeHref, type SiteLocale } from '../lib/i18n';
import { breadcrumbJsonLd } from '../lib/seo';
import type { Category, SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale; category: Category };

const { content, locale, category } = Astro.props;
const products = productsForCategory(content, category.slug);
const path = localePath(locale, `/products/${category.slug}/`);
const productCenter = content.productCenter;
const categoryTitle = productCenter.categoryPage.titleTemplate.replace('{category}', category.name);
const backIcon = productCenter.categoryPage.backIcon;
const localHref = (target: string) => localizeHref(locale, target) as string;
const jsonLd = [breadcrumbJsonLd([
  { name: content.site.navigation.homeLabel, url: localePath(locale, '/') },
  { name: content.site.navigation.productsLabel, url: localePath(locale, '/products/') },
  { name: category.name, url: path }
])];
---

<BaseLayout content={content} seo={category.seo} path={path} locale={locale} jsonLd={jsonLd}>
  <div class="w-full pt-24">
    <InnerPageHero
      id="category-hero"
      eyebrow={content.site.navigation.productsLabel}
      title={category.name}
      description={category.description}
      backgroundImage={category.coverImage}
      backgroundVideo={category.heroVideo}
    />
    <div id="category-products" class="py-24 bg-gray-50 min-h-[60vh] scroll-mt-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-center mb-12 border-b border-gray-200 pb-6">
          <h2 class="text-3xl font-bold text-gray-800 border-l-4 border-brand-800 pl-4">{categoryTitle}</h2>
          <a href={localHref('/products/')} class="mt-4 md:mt-0 flex items-center gap-2 text-brand-800 font-bold hover:bg-blue-50 px-5 py-2.5 rounded-lg transition-colors border border-blue-200">
            <span aria-hidden="true">{backIcon}</span> {productCenter.categoryPage.backLabel}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          {products.map((item) => (
            <a href={localHref(`/products/${category.slug}/${item.slug}/`)} class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col">
              <div class="h-64 overflow-hidden relative">
                <div class="absolute inset-0 bg-brand-800/0 group-hover:bg-brand-800/20 transition-colors z-10 flex items-center justify-center">
                  <span class="bg-white text-brand-800 px-6 py-2 rounded-lg font-bold opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all">{productCenter.categoryPage.productHoverLabel}</span>
                </div>
                {item.coverImage ? (
                  <img src={item.coverImage} alt={item.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                ) : (
                  <div role="img" aria-label={item.name} class="grid h-full w-full place-items-center bg-linear-to-br from-slate-100 via-slate-200 to-slate-300 text-5xl font-black text-slate-400"><span aria-hidden="true">◇</span></div>
                )}
              </div>
              <div class="p-8">
                <h3 class="text-2xl font-extrabold text-gray-800 mb-3">{item.name}</h3>
                <p class="text-gray-500 leading-relaxed text-sm">{item.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
