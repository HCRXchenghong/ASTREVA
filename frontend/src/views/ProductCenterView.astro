---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaCarousel from '../components/MediaCarousel';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import { productsForCategory } from '../lib/content';
import { localePath, localizeHref, type SiteLocale } from '../lib/i18n';
import { resolveIcon } from '../lib/icons';
import { DEFAULT_SCENE_IMAGES, productImage, productImages, sceneImages } from '../lib/default-images';
import { mediaItemsFor } from '../lib/media';
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale };

const { content, locale } = Astro.props;
const productCenter = content.productCenter;
const catalogCopy = productCenter.catalog;
const categories = [...content.categories].sort((a, b) => a.sortOrder - b.sortOrder);
const firstCategory = categories[0];
const categoryCtaIcon = productCenter.categoryPage.categoryCtaIcon;
const catalog = categories.map((category) => ({
  category,
  products: productsForCategory(content, category.slug)
    .sort((a, b) => a.sortOrder - b.sortOrder)
    .slice(0, 4)
}));
const localHref = (path: string) => localizeHref(locale, path) as string;
---

<BaseLayout content={content} seo={productCenter.seo} path={localePath(locale, '/products/')} locale={locale}>
  <div class="min-h-screen w-full bg-surface-50 pt-24">
    <section class="relative flex min-h-[360px] items-end overflow-hidden bg-navy-950 text-white md:min-h-[440px]">
      <MediaCarousel locale={locale} client:load items={mediaItemsFor(productCenter.hero.mediaItems, { image: productCenter.hero.backgroundImage, video: productCenter.hero.backgroundVideo }, sceneImages('municipal'), productCenter.hero.title, 'muted-autoplay')} alt={productCenter.hero.title} background priority fallbackImage={DEFAULT_SCENE_IMAGES.municipal} className="opacity-55" />
      <div class="pointer-events-none absolute inset-0 bg-linear-to-r from-brand-950 via-brand-950/85 to-navy-950/40"></div>
      <div class="pointer-events-none absolute inset-0 bg-navy-950/30"></div>
      <div class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 h-px bg-white/15"></div>
      <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-14 pt-12 md:pb-16 md:pt-16">
        <div class="max-w-3xl">
          <div class="mb-5 flex items-center gap-4">
            <span class="h-px w-10 bg-accent-500" aria-hidden="true"></span>
            <p class="text-xs font-black uppercase tracking-[0.24em] text-accent-500">{catalogCopy.eyebrow}</p>
          </div>
          <h1 class="display-tight text-5xl font-black leading-[1.02] md:text-6xl">{productCenter.hero.title}</h1>
          <p class="mt-5 max-w-xl text-base leading-8 text-slate-300 md:text-lg md:leading-7">
            {catalogCopy.description}
          </p>
        </div>
      </div>
    </section>

    <section id="product-categories" class="scroll-mt-24 py-12 md:py-16">
      <Container>
        <div class="mb-7 flex items-end justify-between gap-6 border-b border-line-200 pb-5">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.2em] text-accent-600">{catalogCopy.categoriesEyebrow}</p>
            <h2 class="mt-2 text-3xl font-black text-ink-800">{catalogCopy.categoriesTitle}</h2>
          </div>
          <p class="hidden max-w-lg text-right text-sm leading-7 text-ink-500 md:block">
            {catalogCopy.categoriesDescription}
          </p>
        </div>

        <div class="grid items-start gap-7 lg:grid-cols-[250px_minmax(0,1fr)]">
          <aside
            class="overflow-hidden rounded-lg border border-line-200 bg-white"
            role="tablist"
            aria-orientation="vertical"
            aria-label={catalogCopy.categoriesAriaLabel}
          >
            {
              categories.map((category, index) => (
                <button
                  type="button"
                  id={`catalog-tab-${category.slug}`}
                  role="tab"
                  class="catalog-trigger"
                  data-category-trigger={category.slug}
                  aria-controls={`catalog-${category.slug}`}
                  aria-selected={category.slug === firstCategory?.slug ? 'true' : 'false'}
                  tabindex={category.slug === firstCategory?.slug ? 0 : -1}
                >
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{category.name}</strong>
                </button>
              ))
            }
          </aside>

          <div>
            {
              catalog.map(({ category, products }) => (
                <section
                  id={`catalog-${category.slug}`}
                  data-category-panel={category.slug}
                  role="tabpanel"
                  aria-labelledby={`catalog-tab-${category.slug}`}
                  tabindex="0"
                  class={`focus:outline-none ${category.slug === firstCategory?.slug ? '' : 'hidden'}`}
                >
                  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                      <h3 class="text-2xl font-black text-ink-800 md:text-3xl">{category.name}</h3>
                      <p class="mt-2 max-w-2xl text-sm leading-7 text-ink-500">{category.description}</p>
                    </div>
                    <a
                      href={localHref(`/products/${category.slug}/`)}
                      class="inline-flex shrink-0 items-center gap-2 text-sm font-black text-brand-500 hover:text-brand-700"
                    >
                      {catalogCopy.viewAllLabel} <Icon name={resolveIcon(categoryCtaIcon)} class="h-4 w-4" />
                    </a>
                  </div>

                  {products.length > 0 ? (
                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                      {products.map((product) => (
                        <div
                          class="group overflow-hidden rounded-lg border border-line-200 bg-white shadow-[0_10px_28px_rgba(15,32,52,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-[0_16px_36px_rgba(15,32,52,0.10)]"
                        >
                          <div class="relative aspect-[16/8.5] overflow-hidden bg-slate-100">
                            <MediaCarousel locale={locale} client:visible items={mediaItemsFor(product.mediaItems, { image: product.coverImage }, productImages(product), product.name)} alt={product.name} className="h-full w-full" fallbackImage={productImage(product)} />
                            {!product.coverImage?.trim() && (
                              <span class="absolute bottom-3 left-3 rounded-full border border-white/25 bg-brand-950/75 px-3 py-1 text-[10px] font-bold tracking-wide text-white backdrop-blur">
                                {productCenter.categoryPage.placeholderImageLabel}
                              </span>
                            )}
                          </div>
                          <div class="flex items-start justify-between gap-5 p-5 md:p-6">
                            <div>
                              <h4 class="text-xl font-black text-ink-800 transition-colors group-hover:text-brand-600"><a href={localHref(`/products/${product.categorySlug}/${product.slug}/`)}>{product.name}</a></h4>
                              <p class="mt-2 line-clamp-2 text-sm leading-6 text-ink-500">{product.summary}</p>
                            </div>
                            <Icon
                              name={resolveIcon(categoryCtaIcon)}
                              class="mt-1 h-5 w-5 shrink-0 text-brand-500 transition-transform group-hover:translate-x-1"
                            />
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div
                      class="rounded-lg border border-dashed border-line-200 bg-white p-10 text-center text-sm text-ink-500"
                    >
                      {catalogCopy.emptyCategoryMessage}
                    </div>
                  )}
                </section>
              ))
            }
          </div>
        </div>
      </Container>
    </section>
  </div>

  <script>
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-category-trigger]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-category-panel]'));

    const activateCategory = (slug: string, focus = false) => {
      triggers.forEach((trigger) => {
        const isActive = trigger.dataset.categoryTrigger === slug;
        trigger.setAttribute('aria-selected', String(isActive));
        trigger.tabIndex = isActive ? 0 : -1;
        if (isActive && focus) trigger.focus();
      });
      panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.categoryPanel !== slug));
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => activateCategory(trigger.dataset.categoryTrigger || ''));
      trigger.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowDown') nextIndex = (index + 1) % triggers.length;
        if (event.key === 'ArrowUp') nextIndex = (index - 1 + triggers.length) % triggers.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = triggers.length - 1;
        const next = triggers[nextIndex];
        activateCategory(next.dataset.categoryTrigger || '', true);
      });
    });
  </script>

  <style>
    .catalog-trigger {
      align-items: center;
      background: #fff;
      border-bottom: 1px solid var(--color-line-100);
      color: var(--color-ink-700);
      display: grid;
      gap: 14px;
      grid-template-columns: 34px 1fr;
      min-height: 68px;
      padding: 0 20px;
      position: relative;
      text-align: left;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
      width: 100%;
    }
    .catalog-trigger:last-child {
      border-bottom: 0;
    }
    .catalog-trigger::before {
      background: var(--color-brand-500);
      bottom: 0;
      content: '';
      left: 0;
      opacity: 0;
      position: absolute;
      top: 0;
      width: 4px;
    }
    .catalog-trigger span {
      color: var(--color-ink-400);
      font-size: 12px;
      font-weight: 900;
    }
    .catalog-trigger strong {
      font-size: 15px;
      font-weight: 900;
    }
    .catalog-trigger:hover,
    .catalog-trigger[aria-selected='true'] {
      background: var(--color-brand-50);
      color: var(--color-brand-800);
    }
    .catalog-trigger[aria-selected='true']::before {
      opacity: 1;
    }
    .catalog-trigger[aria-selected='true'] span {
      color: var(--color-brand-500);
    }
  </style>
</BaseLayout>
