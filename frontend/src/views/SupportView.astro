---
import ContactForm from '../components/ContactForm';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, localizeHref, type SiteLocale } from '../lib/i18n';
import { resolveIcon } from '../lib/icons';
import { contactPageJsonLd } from '../lib/seo';
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale };

const { content, locale } = Astro.props;
const support = content.support;
const phone = content.site.phone?.trim();
const email = content.site.email?.trim();
const hasContactDetails = Boolean(phone || email);
const localHref = (target: string) => localizeHref(locale, target) as string;
---

<BaseLayout
  content={content}
  seo={support.seo}
  path={localePath(locale, '/support/')}
  locale={locale}
  jsonLd={[contactPageJsonLd(content.site)]}
>
  <div class="w-full pt-24">
    <InnerPageHero
      id="support-hero"
      title={support.hero.title}
      description={support.hero.description}
      backgroundImage={support.hero.backgroundImage}
      backgroundVideo={support.hero.backgroundVideo}
    />
    <div class="py-24 bg-white">
      <Container>
        <div id="support-services" class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-24 scroll-mt-24">
          {
            support.services.map((service) => (
              <div class="group rounded-xl border border-line-100 bg-white p-10 text-center transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_24px_60px_-30px_rgba(10,64,112,0.35)]">
                <span class="mx-auto mb-6 grid h-16 w-16 place-items-center rounded-2xl bg-brand-50 text-brand-500 transition-colors group-hover:bg-brand-500 group-hover:text-white">
                  <Icon name={resolveIcon(service.icon, 'service')} class="h-8 w-8" />
                </span>
                <h3 class="mb-3 text-xl font-black text-ink-900">{service.title}</h3>
                <p class="mb-6 text-sm leading-7 text-ink-500">{service.description}</p>
                <a
                  href={localHref(service.href)}
                  class="inline-flex items-center gap-2 text-sm font-black text-brand-500"
                >
                  {service.cta}
                  <Icon name="arrowRight" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </a>
              </div>
            ))
          }
        </div>
        <div
          id="support-contact"
          class="mx-auto grid max-w-5xl scroll-mt-24 overflow-hidden rounded-2xl border border-line-100 bg-white md:grid-cols-5"
        >
          <div class="flex flex-col justify-between bg-surface-50 p-10 md:col-span-2 md:p-12">
            <div>
              <span class="mb-6 block h-px w-10 bg-accent-500" aria-hidden="true"></span>
              <h3 class="text-2xl font-black text-brand-950">{support.contact.title}</h3>
              <p class="mt-4 text-sm leading-7 text-ink-500">{support.contact.description}</p>
              {
                hasContactDetails && (
                  <div class="mt-10 space-y-5">
                    {phone && (
                      <div class="flex items-center gap-4">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-white text-brand-500 shadow-sm">
                          <Icon name={resolveIcon(support.contact.phoneIcon)} class="h-5 w-5" />
                        </span>
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">
                            {support.contact.phoneLabel}
                          </p>
                          <p class="font-bold text-ink-900">{phone}</p>
                        </div>
                      </div>
                    )}
                    {email && (
                      <div class="flex items-center gap-4">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-white text-brand-500 shadow-sm">
                          <Icon name={resolveIcon(support.contact.emailIcon)} class="h-5 w-5" />
                        </span>
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">
                            {support.contact.emailLabel}
                          </p>
                          <p class="font-bold text-ink-900">{email}</p>
                        </div>
                      </div>
                    )}
                  </div>
                )
              }
            </div>
          </div>
          <div class="p-10 md:col-span-3 md:p-12">
            <ContactForm client:load form={support.contact.form} />
          </div>
        </div>
      </Container>
    </div>
  </div>
</BaseLayout>
