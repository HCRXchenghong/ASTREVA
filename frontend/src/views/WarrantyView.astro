---
import InnerPageHero from '../components/InnerPageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { staticPage } from '../lib/content';
import { localePath, type SiteLocale } from '../lib/i18n';
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale };

const { content, locale } = Astro.props;
const page = staticPage(content, 'warranty');
---

<BaseLayout content={content} seo={page.seo} path={localePath(locale, '/support/warranty/')} locale={locale}>
  <div class="w-full pt-24">
    <InnerPageHero
      id="warranty-hero"
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      description={page.hero.description}
      subtitle={page.hero.subtitle}
      backgroundImage={page.hero.backgroundImage}
      backgroundVideo={page.hero.backgroundVideo}
    />
    <div id="warranty-content" class="py-24 bg-slate-50 min-h-[60vh] scroll-mt-24">
      <div class="max-w-4xl mx-auto px-6 bg-white p-12 md:p-16 rounded-3xl shadow-sm border border-gray-100">
        <h2 class="text-4xl font-extrabold text-gray-900 mb-8 flex items-center gap-4"><span class="text-[#0a66c2]" aria-hidden="true">{page.sections.icon}</span> {page.title}</h2>
        <div class="prose-content text-gray-600 leading-relaxed space-y-6" set:html={page.body}></div>
      </div>
    </div>
  </div>
</BaseLayout>
