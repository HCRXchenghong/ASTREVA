---
import Icon from '../components/ui/Icon.astro';
import Container from '../components/ui/Container.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import MediaCarousel from '../components/MediaCarousel';
import { mediaItemsFor } from '../lib/media';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, localizeHref, safeHref, type SiteLocale } from '../lib/i18n';
import { resolveIcon } from '../lib/icons';
import { breadcrumbJsonLd, productJsonLd } from '../lib/seo';
import { resolveVideoSource } from '../lib/video';
import { productImage, productImages } from '../lib/default-images';
import type { Category, Product, SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale; product: Product; category: Category };

const { content, locale, product, category } = Astro.props;
const path = localePath(locale, `/products/${product.categorySlug}/${product.slug}/`);
const productCenter = content.productCenter;
const detail = productCenter.detailPage;
const breadcrumbSeparator = detail.breadcrumbSeparator;
const badgeIcon = detail.badgeIcon;
const featureIcon = detail.featureIcon;
const quoteButtonIcon = detail.quoteButtonIcon;
const downloadButtonIcon = detail.downloadButtonIcon;
const video = resolveVideoSource(product.videoUrl);
const isMp4Video = video.isFile;
const downloads = product.downloads.filter((download) => download.url);
const specifications = product.specifications.filter((spec) => spec.label || spec.value);
const configuredGalleryImages = product.galleryImages.filter(Boolean);
const coverImage = productImage(product);
const coverMedia = mediaItemsFor(product.mediaItems, { image: product.coverImage }, productImages(product), product.name);
const galleryMedia = mediaItemsFor(product.galleryMediaItems, { image: configuredGalleryImages }, productImages(product), product.name);
const videoMedia = mediaItemsFor(product.videoMediaItems, { video: [product.videoUrl || '', ...(product.galleryVideos || [])] }, productImages(product), product.name);
const showVideoSection = product.videoMediaItems !== undefined || Boolean(product.videoUrl?.trim()) || Boolean(product.galleryVideos?.some((url) => url.trim()));
const isPlaceholderCover = !product.coverImage?.trim();
const localHref = (target: string) => localizeHref(locale, target) as string;
const jsonLd = [
  productJsonLd(product, category, content.site),
  breadcrumbJsonLd([
    { name: content.site.navigation.homeLabel, url: localePath(locale, '/') },
    { name: content.site.navigation.productsLabel, url: localePath(locale, '/products/') },
    { name: category.name, url: localePath(locale, `/products/${category.slug}/`) },
    { name: product.name, url: path }
  ])
];
---

<BaseLayout content={content} seo={product.seo} path={path} locale={locale} jsonLd={jsonLd}>
  <div class="w-full pt-24">
    <InnerPageHero locale={locale}
      id="product-page-hero"
      eyebrow={category.name}
      title={product.name}
      description={product.summary}
      backgroundImage={product.coverImage}
      backgroundVideo={isMp4Video ? product.videoUrl : category.heroVideo}
      mediaItems={product.mediaItems}
      defaultImages={productImages(product)}
    />
    <div class="bg-gray-50 border-b border-gray-200">
      <Container class="py-4 flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <a href={localHref('/')} class="hover:text-brand-500 transition-colors">{content.site.navigation.homeLabel}</a>
        <span aria-hidden="true">{breadcrumbSeparator}</span>
        <a href={localHref('/products/')} class="hover:text-brand-500 transition-colors"
          >{content.site.navigation.productsLabel}</a
        >
        <span aria-hidden="true">{breadcrumbSeparator}</span>
        <a href={localHref(`/products/${category.slug}/`)} class="hover:text-brand-500 transition-colors"
          >{category.name}</a
        >
        <span aria-hidden="true">{breadcrumbSeparator}</span>
        <span class="text-gray-900 font-bold">{product.name}</span>
      </Container>
    </div>
    <section id="product-detail-hero" class="py-16 bg-white scroll-mt-24">
      <Container class="flex flex-col lg:flex-row gap-16 items-center">
        <div class="lg:w-1/2">
          <div class="rounded-3xl overflow-hidden shadow-2xl border border-gray-100 aspect-[4/3] group relative">
            <MediaCarousel locale={locale} client:visible items={coverMedia} alt={product.name} className="h-full w-full" fallbackImage={coverImage} />
            {isPlaceholderCover && (
              <span class="absolute bottom-4 left-4 rounded-full border border-white/25 bg-brand-950/80 px-3 py-1.5 text-[11px] font-bold tracking-wide text-white backdrop-blur">
                {detail.placeholderImageLabel}
              </span>
            )}
            <div
              class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
          </div>
        </div>
        <div class="lg:w-1/2">
          <div
            class="inline-flex items-center gap-2 rounded-full border border-brand-100 bg-brand-50 px-4 py-1.5 text-xs font-black uppercase tracking-wide text-brand-700 mb-6"
          >
            <Icon name={resolveIcon(badgeIcon)} class="h-4 w-4" />
            {detail.badgeLabel}
          </div>
          <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6 leading-tight md:leading-none">
            {product.name}
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed mb-8">{product.summary}</p>
          <div class="space-y-4 mb-10">
            {
              product.features.map((feature) => (
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded-full bg-brand-500/10 flex items-center justify-center shrink-0">
                    <Icon name={resolveIcon(featureIcon)} class="h-3.5 w-3.5 text-brand-500" strokeWidth={2.2} />
                  </div>
                  <span class="text-gray-700 font-medium">{feature}</span>
                </div>
              ))
            }
          </div>
          <div class="flex flex-wrap gap-4">
            <a
              href={localHref('/support/')}
              class="bg-brand-500 hover:bg-brand-700 text-white px-8 py-4 rounded-xl font-bold transition-all shadow-lg hover:shadow-xl flex items-center gap-2"
            >
              <Icon name={resolveIcon(quoteButtonIcon)} class="h-4 w-4" />
              {detail.quoteButtonLabel}
            </a>
            {
              downloads.map((download) => (
                <a
                  href={safeHref(download.url)}
                  class="bg-white border-2 border-gray-200 text-gray-700 hover:border-brand-500 hover:text-brand-500 px-8 py-4 rounded-xl font-bold transition-all flex items-center gap-2"
                >
                  <Icon name={resolveIcon(downloadButtonIcon)} class="h-4 w-4" /> {download.label}
                </a>
              ))
            }
          </div>
        </div>
      </Container>
    </section>
    <section id="product-specs" class="py-20 bg-gray-50 scroll-mt-24">
      <Container>
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-extrabold text-gray-900 mb-4">{detail.specsTitle}</h2>
          <p class="text-gray-500">{detail.specsDescription}</p>
        </div>
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
          {
            specifications.length > 0 && (
              <div class="p-8 md:p-10">
                <div class="mb-6 flex items-center gap-5">
                  <Icon name={resolveIcon(detail.specsPrimaryIcon)} class="h-9 w-9 shrink-0 text-brand-500" />
                  <h4 class="text-xl font-bold text-gray-900">{detail.specsPrimaryTitle}</h4>
                </div>
                <table class="w-full border-collapse text-sm">
                  <tbody class="divide-y divide-gray-100">
                    {specifications.map((spec) => (
                      <tr class="align-top">
                        <th scope="row" class="w-2/5 py-3 pr-6 text-left font-bold text-gray-900 md:w-1/3">
                          {spec.label}
                        </th>
                        <td class="py-3 text-gray-600">{spec.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }
          {
            specifications.length === 0 && (
              <p class="px-8 pt-8 text-sm leading-7 text-ink-500 md:px-10" role="status">
                {detail.specsEmptyMessage}
              </p>
            )
          }
          <div class={`p-8 md:p-10 ${specifications.length > 0 ? 'border-t border-gray-100 bg-gray-50/60' : ''}`}>
            <div class="mb-4 flex items-center gap-5">
              <Icon name={resolveIcon(detail.descriptionIcon, 'description')} class="h-9 w-9 shrink-0 text-brand-500" />
              <h4 class="text-xl font-bold text-gray-900">{detail.descriptionTitle}</h4>
            </div>
            <div class="text-gray-600 text-sm leading-relaxed" set:html={product.body} />
          </div>
        </div>
      </Container>
    </section>
    {
      galleryMedia.length > 0 && (
        <section id="product-gallery" class="py-20 bg-white scroll-mt-24">
          <Container>
            <h2 class="text-3xl font-extrabold text-gray-900 mb-10">{detail.galleryTitle}</h2>
            <MediaCarousel locale={locale} client:visible items={galleryMedia} alt={product.name} className="mx-auto aspect-[4/3] w-full max-w-4xl rounded-2xl shadow-sm" fallbackImage={coverImage} />
          </Container>
        </section>
      )
    }
    {
      showVideoSection && videoMedia.length > 0 && (
        <section id="product-video" class="py-20 bg-gray-50 scroll-mt-24">
          <Container size="mid">
            <h2 class="text-3xl font-extrabold text-gray-900 mb-8 text-center">{detail.videoTitle}</h2>
            <MediaCarousel locale={locale} client:visible items={videoMedia} alt={detail.videoTitle} className="aspect-video w-full rounded-3xl shadow-xl" fallbackImage={coverImage} />
          </Container>
        </section>
      )
    }
  </div>
</BaseLayout>
