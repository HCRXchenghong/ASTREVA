---
import VideoModal from '../components/VideoModal';
import MediaCarousel from '../components/MediaCarousel';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { featuredProducts } from '../lib/content';
import { localePath, localizeHref, type SiteLocale } from '../lib/i18n';
import { resolveIcon } from '../lib/icons';
import { DEFAULT_SCENE_IMAGES, productImage, productImages, resolveImage, sceneImages } from '../lib/default-images';
import { mediaItemsFor } from '../lib/media';
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale };

const { content, locale } = Astro.props;
const home = content.home;
const featured = featuredProducts(content, 3);
const localHref = (path: string) => localizeHref(locale, path) as string;
const categoryName = (slug: string) => content.categories.find((category) => category.slug === slug)?.name || '';
const proofPoints = home.advantages.slice(0, 4);
const pad = (index: number) => String(index + 1).padStart(2, '0');
const heroMedia = mediaItemsFor(home.hero.mediaItems, { image: home.hero.backgroundImage, video: home.hero.backgroundVideo }, sceneImages('homeHero'), home.hero.title, 'muted-autoplay');
---

<BaseLayout content={content} seo={home.seo} path={localePath(locale, '/')} locale={locale}>
  <div class="w-full">
    <!-- Hero: full-bleed media, blueprint grid, proof bar pinned to the bottom -->
    <section
      id="home-hero"
      class="relative flex min-h-[100svh] flex-col justify-between overflow-hidden bg-navy-950 scroll-mt-24"
    >
      <MediaCarousel locale={locale} client:load items={heroMedia} alt={home.hero.title} background priority fallbackImage={DEFAULT_SCENE_IMAGES.homeHero} activeMediaEvent="astreva:home-hero-media" controls={false} />
      <div class="pointer-events-none absolute inset-0 bg-linear-to-r from-brand-950/95 via-brand-950/70 to-transparent"></div>
      <div class="pointer-events-none absolute inset-0 bg-navy-950/45"></div>
      <div class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <Container class="relative z-10 flex flex-1 flex-col justify-center pb-10 pt-28 md:pb-16 md:pt-36">
        <div class="flex items-center gap-4">
          <span class="h-px w-10 bg-accent-500" aria-hidden="true"></span>
          <p class="text-sm font-bold uppercase tracking-[0.24em] text-accent-500">{home.hero.eyebrow}</p>
        </div>
        <h1
          class="display-tight mt-5 max-w-5xl text-5xl font-black leading-[0.98] text-white sm:text-6xl md:mt-6 md:text-8xl md:leading-[0.95]"
        >
          {home.hero.title}<span class="relative -top-[0.55em] align-top text-[0.22em] tracking-normal text-white/60">
            {home.hero.trademark}
          </span>
        </h1>
        <p class="mt-5 max-w-xl text-base font-light leading-relaxed text-slate-200 md:mt-8 md:text-2xl">
          {home.hero.subtitle}
        </p>
        <div class="mt-8 md:mt-12">
          <VideoModal locale={locale}
            client:load
            primaryLabel={home.hero.primaryCta}
            primaryHref={localHref(home.hero.primaryHref)}
            secondaryLabel={home.hero.secondaryCta}
            videoUrl={home.hero.videoUrl}
            mediaItems={home.hero.videoMediaItems}
            videoTitle={home.hero.videoTitle}
            videoModalEyebrow={home.hero.videoModalEyebrow}
            videoModalDescription={home.hero.videoModalDescription}
            videoModalBackgroundImage={home.hero.videoModalBackgroundImage}
            videoModalBackgroundMediaItems={home.hero.videoModalBackgroundMediaItems}
            videoPosterImage={resolveImage(home.hero.videoPosterImage, DEFAULT_SCENE_IMAGES.homeHero)}
            previewLabel={home.hero.videoPreviewLabel}
            openExternalLabel={home.hero.videoOpenExternalLabel}
            closeLabel={home.hero.videoCloseLabel}
            showSecondary={heroMedia[0]?.type === 'video'}
            activeMediaEvent="astreva:home-hero-media"
          />
        </div>
      </Container>

      {
        proofPoints.length > 0 && (
          <Container class="home-hero-proof-bar relative z-10 hidden md:block">
            <div class="grid grid-cols-2 gap-px overflow-hidden border-t border-white/15 md:grid-cols-4">
              {proofPoints.map((item) => (
                <div class="flex items-baseline gap-3 py-5 pr-6">
                  <Icon name={resolveIcon(item.icon, 'advantage')} class="h-5 w-5 shrink-0 text-accent-500" />
                  <span class="text-sm font-semibold text-white/85">{item.title}</span>
                </div>
              ))}
            </div>
          </Container>
        )
      }
    </section>

    <!-- Products -->
    <section id="home-products" class="bg-white py-28 scroll-mt-24">
      <Container>
        <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <SectionHeading
            align="left"
            title={home.featuredProducts.title}
            description={home.featuredProducts.description}
            class="max-w-2xl"
          />
        </div>

        <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
          {
            featured.map((item, index) => (
              <div
                class={`reveal group relative flex flex-col overflow-hidden rounded-xl border border-line-100 bg-white transition-all duration-500 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_24px_60px_-24px_rgba(10,64,112,0.35)] reveal-delay-${index * 90}`}
              >
                <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
              <MediaCarousel locale={locale} client:visible items={mediaItemsFor(item.mediaItems, { image: item.coverImage }, productImages(item), item.name)} alt={item.name} className="h-full w-full" fallbackImage={productImage(item)} />
              {!item.coverImage?.trim() && (
                <span class="absolute bottom-3 left-3 rounded-full border border-white/25 bg-brand-950/75 px-3 py-1 text-[10px] font-bold tracking-wide text-white backdrop-blur">
                  {content.productCenter.categoryPage.placeholderImageLabel}
                </span>
              )}
                  <span class="absolute left-5 top-5 rounded-full bg-white/95 px-3 py-1 text-[11px] font-black uppercase tracking-[0.14em] text-brand-800 backdrop-blur">
                    {categoryName(item.categorySlug)}
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-7">
                  <h3 class="text-xl font-black text-ink-900"><a href={localHref(`/products/${item.categorySlug}/${item.slug}/`)}>{item.name}</a></h3>
                  <p class="mt-3 line-clamp-2 flex-1 text-sm leading-6 text-ink-500">{item.summary}</p>
                  <a href={localHref(`/products/${item.categorySlug}/${item.slug}/`)} class="mt-6 inline-flex items-center gap-2 text-sm font-black text-brand-500">
                    {home.featuredProducts.linkLabel}
                    <Icon
                      name={resolveIcon(home.featuredProducts.linkIcon)}
                      class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    />
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </Container>
    </section>

    <!-- Product intro: asymmetric split -->
    <section id="home-product-intro" class="relative overflow-hidden bg-surface-50 py-28 scroll-mt-24">
      <div class="blueprint-grid-light absolute inset-0" aria-hidden="true"></div>
      <Container class="relative grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="reveal lg:col-span-5">
          <span class="mb-6 block h-px w-12 bg-accent-500" aria-hidden="true"></span>
          <h2 class="display-tight text-4xl font-black text-brand-950 md:text-5xl">{home.productIntro.title}</h2>
          <p class="mt-6 text-base leading-8 text-ink-600">{home.productIntro.description}</p>
          <ul class="mt-10 divide-y divide-line-100 border-y border-line-100">
            {
              home.productIntro.bullets.map((text) => (
                <li class="flex items-center gap-4 py-4 text-sm font-semibold text-ink-800">
                  <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-500/10 text-brand-500">
                    <Icon name={resolveIcon(home.productIntro.bulletIcon)} class="h-4 w-4" strokeWidth={2} />
                  </span>
                  {text}
                </li>
              ))
            }
          </ul>
          <div class="mt-10">
            <Button href={localHref(home.productIntro.ctaHref)} variant="primary">
              {home.productIntro.ctaLabel}
            </Button>
          </div>
        </div>

        <div class="reveal reveal-delay-120 relative lg:col-span-7">
          <span
            class="absolute -left-4 -top-4 hidden h-24 w-24 border-l-2 border-t-2 border-accent-500 lg:block"
            aria-hidden="true"></span>
          <div
            class="relative aspect-[4/3] overflow-hidden rounded-xl bg-slate-100 shadow-[0_40px_80px_-40px_rgba(3,32,60,0.55)]"
          >
            <MediaCarousel locale={locale} client:visible items={mediaItemsFor(home.productIntro.mediaItems, { image: home.productIntro.image }, sceneImages('homeProductIntro'), home.productIntro.title)} alt={home.productIntro.title} background fallbackImage={DEFAULT_SCENE_IMAGES.homeProductIntro} />
          </div>
        </div>
      </Container>
    </section>

    <!-- Advantages: navy, hairline grid, outlined numerals -->
    <section id="home-advantages" class="relative overflow-hidden bg-navy-950 py-28 text-white scroll-mt-24">
      <div class="blueprint-grid absolute inset-0" aria-hidden="true"></div>
      <Container class="relative">
        <div class="reveal max-w-3xl">
          <span class="mb-6 block h-px w-12 bg-accent-500" aria-hidden="true"></span>
          <h2 class="display-tight text-4xl font-black text-white md:text-5xl">{home.advantagesIntro.title}</h2>
          <p class="mt-5 max-w-2xl text-base leading-8 text-slate-300">{home.advantagesIntro.description}</p>
        </div>

        <div class="mt-24 grid grid-cols-1 border-t border-white/12 md:grid-cols-2">
          {
            home.advantages.map((item, index) => (
              <div
                class:list={[
                  'reveal group relative border-b border-white/12 py-10 pr-6 transition-colors hover:bg-white/[0.03]',
                  index % 2 === 0 ? 'md:border-r md:border-white/12 md:pr-12' : 'md:pl-12',
                  `reveal-delay-${index * 80}`
                ]}
              >
                <div class="flex items-start justify-between gap-6">
                  <div class="max-w-md">
                    <div class="mb-5 flex items-center gap-3">
                      <Icon name={resolveIcon(item.icon, 'advantage')} class="h-6 w-6 shrink-0 text-accent-500" />
                      <h3 class="text-xl font-bold text-white">{item.title}</h3>
                    </div>
                    <p class="text-sm leading-7 text-slate-400">{item.description}</p>
                  </div>
                  <span class="index-numeral shrink-0 text-5xl font-black md:text-6xl" aria-hidden="true">
                    {pad(index)}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </Container>
    </section>

    {
      home.testimonials.length > 0 && (
        <section id="home-testimonials" class="bg-white py-28 scroll-mt-24">
          <Container>
            <div class="reveal max-w-2xl">
              <span class="mb-6 block h-px w-12 bg-accent-500" aria-hidden="true" />
              <h2 class="display-tight text-4xl font-black text-brand-950 md:text-5xl">{home.testimonialsTitle}</h2>
            </div>
            <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
              {home.testimonials.map((review, index) => (
                <figure
                  class={`reveal flex flex-col justify-between rounded-xl border border-line-100 bg-surface-50 p-8 transition-colors hover:border-brand-200 reveal-delay-${index * 80}`}
                >
                  <blockquote class="text-base leading-8 text-ink-700">“{review.text}”</blockquote>
                  <figcaption class="mt-8 flex items-center gap-4 border-t border-line-100 pt-6">
                    <span class="grid h-11 w-11 place-items-center rounded-full bg-brand-800 text-sm font-black text-white">
                      {review.name[0]}
                    </span>
                    <span>
                      <span class="block text-sm font-bold text-ink-900">{review.name}</span>
                      <span class="block text-xs text-ink-500">{review.role}</span>
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </Container>
        </section>
      )
    }

    <!-- Closing CTA: a light band, so the navy advantages section above and the
         navy footer below don't merge into one undifferentiated dark block. -->
    <section id="home-cta" class="relative overflow-hidden border-t border-line-100 bg-white py-24 scroll-mt-24">
      <div class="blueprint-grid-light absolute inset-0" aria-hidden="true"></div>
      <MediaCarousel locale={locale} client:visible items={mediaItemsFor(home.cta.mediaItems, { image: home.cta.backgroundImage }, sceneImages('homeHero'), home.cta.title)} alt={home.cta.title} background fallbackImage={DEFAULT_SCENE_IMAGES.homeHero} mediaClassName="opacity-[0.04]" />
      <Container class="relative">
        <div class="reveal grid items-center gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <span class="mb-6 block h-px w-12 bg-accent-500" aria-hidden="true"></span>
            <h2 class="display-tight max-w-2xl text-4xl font-black text-brand-950 md:text-5xl">{home.cta.title}</h2>
            <p class="mt-5 max-w-xl text-base leading-8 text-ink-500">{home.cta.description}</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
            <Button href={localHref(home.cta.primaryHref)} variant="primary" size="lg">
              {home.cta.primaryLabel}
            </Button>
            <Button href={localHref(home.cta.secondaryHref)} variant="outline" size="lg">
              {home.cta.secondaryLabel}
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>
