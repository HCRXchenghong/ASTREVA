---
import InnerPageHero from '../components/InnerPageHero.astro';
import Container from '../components/ui/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { staticPage } from '../lib/content';
import { localePath, type SiteLocale } from '../lib/i18n';
import { resolveIcon } from '../lib/icons';
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale };

const { content, locale } = Astro.props;
const page = staticPage(content, 'install');
---

<BaseLayout content={content} seo={page.seo} path={localePath(locale, '/support/install/')} locale={locale}>
  <div class="w-full pt-24">
    <InnerPageHero locale={locale}
      id="install-hero"
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      description={page.hero.description}
      backgroundImage={page.hero.backgroundImage}
      backgroundVideo={page.hero.backgroundVideo}
      mediaItems={page.hero.mediaItems}
    />
    <div id="install-content" class="py-24 bg-slate-50 min-h-[60vh] scroll-mt-24">
      <Container size="mid">
        <h2 class="text-4xl font-extrabold text-center text-gray-900 mb-16 flex items-center justify-center gap-3">
          <Icon name={resolveIcon(page.sections.icon)} class="h-8 w-8 shrink-0 text-brand-500" />
          {page.title}
        </h2>
        <div
          class="bg-white p-10 md:p-14 rounded-3xl shadow-sm border border-gray-100 prose-content"
          set:html={page.body}
        />
      </Container>
    </div>
  </div>
</BaseLayout>
