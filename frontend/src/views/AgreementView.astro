---
import InnerPageHero from '../components/InnerPageHero.astro';
import Container from '../components/ui/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { staticPage } from '../lib/content';
import { localePath, type SiteLocale } from '../lib/i18n';
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale };

const { content, locale } = Astro.props;
const page = staticPage(content, 'agreement');
---

<BaseLayout content={content} seo={page.seo} path={localePath(locale, '/agreement/')} locale={locale}>
  <div class="w-full pt-24">
    <InnerPageHero
      id="agreement-hero"
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      description={page.hero.description}
      backgroundImage={page.hero.backgroundImage}
      backgroundVideo={page.hero.backgroundVideo}
    />
    <div id="agreement-content" class="py-24 bg-white min-h-[60vh] scroll-mt-24">
      <Container size="narrow">
        <h2 class="text-4xl font-extrabold text-gray-900 mb-10 border-b border-gray-200 pb-6">{page.title}</h2>
        <div class="prose-content text-gray-600 leading-loose space-y-6" set:html={page.body} />
      </Container>
    </div>
  </div>
</BaseLayout>
