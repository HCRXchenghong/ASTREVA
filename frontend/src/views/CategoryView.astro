---
import InnerPageHero from '../components/InnerPageHero.astro';
import MediaCarousel from '../components/MediaCarousel';
import { mediaItemsFor } from '../lib/media';
import Container from '../components/ui/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { productsForCategory } from '../lib/content';
import { localePath, localizeHref, type SiteLocale } from '../lib/i18n';
import { resolveIcon } from '../lib/icons';
import { categoryImages, productImage, productImages } from '../lib/default-images';
import { breadcrumbJsonLd } from '../lib/seo';
import type { Category, SiteContent } from '../lib/types';

type Props = { content: SiteContent; locale: SiteLocale; category: Category };

const { content, locale, category } = Astro.props;
const products = productsForCategory(content, category.slug);
const path = localePath(locale, `/products/${category.slug}/`);
const productCenter = content.productCenter;
const categoryTitle = productCenter.categoryPage.titleTemplate.replace('{category}', category.name);
const backIcon = productCenter.categoryPage.backIcon;
const localHref = (target: string) => localizeHref(locale, target) as string;
const jsonLd = [
  breadcrumbJsonLd([
    { name: content.site.navigation.homeLabel, url: localePath(locale, '/') },
    { name: content.site.navigation.productsLabel, url: localePath(locale, '/products/') },
    { name: category.name, url: path }
  ])
];
---

<BaseLayout content={content} seo={category.seo} path={path} locale={locale} jsonLd={jsonLd}>
  <div class="w-full pt-24">
    <InnerPageHero locale={locale}
      id="category-hero"
      eyebrow={content.site.navigation.productsLabel}
      title={category.name}
      description={category.description}
      backgroundImage={category.coverImage}
      backgroundVideo={category.heroVideo}
      mediaItems={category.mediaItems}
      defaultImages={categoryImages(category)}
    />
    <div id="category-products" class="py-24 bg-gray-50 min-h-[60vh] scroll-mt-24">
      <Container>
        <div class="flex flex-col md:flex-row justify-between items-center mb-12 border-b border-gray-200 pb-6">
          <h2 class="text-3xl font-bold text-gray-800 border-l-4 border-brand-800 pl-4">{categoryTitle}</h2>
          <a
            href={localHref('/products/')}
            class="mt-4 md:mt-0 flex items-center gap-2 text-brand-800 font-bold hover:bg-surface-50 px-5 py-2.5 rounded-lg transition-colors border border-line-200"
          >
            <Icon name={resolveIcon(backIcon)} class="h-4 w-4" />
            {productCenter.categoryPage.backLabel}
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          {
            products.map((item) => (
              <div
                class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col"
              >
                <div class="h-64 overflow-hidden relative">
                  <MediaCarousel locale={locale} client:visible items={mediaItemsFor(item.mediaItems, { image: item.coverImage }, productImages(item), item.name)} alt={item.name} className="h-full w-full" fallbackImage={productImage(item)} />
                  {!item.coverImage?.trim() && (
                    <span class="absolute bottom-3 left-3 z-20 rounded-full border border-white/25 bg-brand-950/75 px-3 py-1 text-[10px] font-bold tracking-wide text-white backdrop-blur">
                      {productCenter.categoryPage.placeholderImageLabel}
                    </span>
                  )}
                </div>
                <div class="p-8">
                  <h3 class="text-2xl font-extrabold text-gray-800 mb-3"><a href={localHref(`/products/${category.slug}/${item.slug}/`)}>{item.name}</a></h3>
                  <p class="text-gray-500 leading-relaxed text-sm">{item.summary}</p>
                </div>
              </div>
            ))
          }
        </div>
      </Container>
    </div>
  </div>
</BaseLayout>
