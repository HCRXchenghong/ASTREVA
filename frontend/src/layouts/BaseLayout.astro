---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import ChatWidget from '../components/ChatWidget';
import CookieConsent from '../components/CookieConsent';
import LanguageController from '../components/LanguageController.astro';
import { PUBLIC_CONTENT_API_URL, getAvailableLocales } from '../lib/content';
import {
  DEFAULT_LOCALE,
  OG_LOCALES,
  SITE_LOCALES,
  isSiteLocale,
  localePath,
  localeSwitchPaths,
  localizeHref,
  stripLocalePrefix,
  type SiteLocale
} from '../lib/i18n';
import { absoluteAssetUrl, absoluteUrl, organizationJsonLd, pageDescription, pageTitle, websiteJsonLd } from '../lib/seo';
import type { SEO, SiteContent } from '../lib/types';

type Props = {
  content: SiteContent;
  seo?: SEO;
  path: string;
  jsonLd?: unknown[];
  /** Optional robots policy, e.g. "noindex, follow" for the 404 page. */
  robots?: string;
  /** Real page language; zh-CN keeps the root path, en/ar live behind their prefix. */
  locale?: SiteLocale;
};

const {
  content,
  seo,
  path,
  jsonLd = [],
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  locale: localeProp
} = Astro.props;
const locale: SiteLocale = isSiteLocale(localeProp)
  ? localeProp
  : isSiteLocale(content.site.locale)
    ? content.site.locale
    : DEFAULT_LOCALE;
const title = pageTitle(seo, content.site);
const description = pageDescription(seo, content.site);
const canonical = absoluteUrl(path);
const imageSource = seo?.image || content.site.defaultSeo.image || content.site.logoUrl;
const image = absoluteAssetUrl(imageSource);
const keywords = seo?.keywords || content.site.defaultSeo.keywords;
const ogLocale = OG_LOCALES[locale];
const availableLocales = await getAvailableLocales();
if (!availableLocales.includes(locale)) availableLocales.push(locale);
const alternateLocales = SITE_LOCALES.filter((item) => availableLocales.includes(item) && item !== locale);
const basePath = stripLocalePrefix(path).path;
const hreflangAlternates = availableLocales.map((item) => ({
  locale: item,
  href: absoluteUrl(localePath(item, basePath))
}));
const switchPaths = localeSwitchPaths(path, availableLocales);
const verification = content.site.searchVerification || {};
const isLogoImage = Boolean(image && imageSource === content.site.logoUrl);
const structuredData = [organizationJsonLd(content.site), websiteJsonLd(content.site), ...jsonLd];
const footer = content.site.footer;
const isIndexable = !/noindex/i.test(robots);
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline define:vars={{ astrevaLocale: locale, astrevaLocales: availableLocales, astrevaLocalePaths: switchPaths }}>
      window.__ASTREVA_LOCALE__ = astrevaLocale;
      window.__ASTREVA_LOCALES__ = astrevaLocales;
      window.__ASTREVA_LOCALE_PATHS__ = astrevaLocalePaths;
    </script>
    <!-- First-party analytics: consent-gated page view and event beacon. -->
    <script is:inline define:vars={{ astrevaAnalyticsBase: PUBLIC_CONTENT_API_URL }}>
      (() => {
        const CONSENT_KEY = 'astreva_cookie_consent';
        const VISITOR_KEY = 'astreva_visitor_id';
        const SESSION_KEY = 'astreva_session_id';
        const ENDPOINT = '/site-admin-api/analytics/visit';
        // Only the optional analytics category is gated: without consent nothing
        // is sent and no identifier is written to storage.
        function analyticsAllowed() {
          try {
            const raw = localStorage.getItem(CONSENT_KEY);
            if (!raw) return false;
            if (raw === 'accepted') return true;
            const parsed = JSON.parse(raw);
            return !!(parsed && parsed.analytics === true);
          } catch {
            return false;
          }
        }
        function identifier(storage, key) {
          try {
            const existing = storage.getItem(key);
            if (existing) return existing;
            const value = window.crypto && typeof window.crypto.randomUUID === 'function'
              ? window.crypto.randomUUID()
              : `anon-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
            storage.setItem(key, value);
            return value;
          } catch {
            return '';
          }
        }
        function endpoint() {
          const base = String(astrevaAnalyticsBase || '').replace(/\/$/, '');
          return `${base}${ENDPOINT}`;
        }
        function send(payload) {
          const body = JSON.stringify(payload);
          try {
            if (typeof navigator.sendBeacon === 'function') {
              // text/plain keeps the beacon a CORS-simple request: the public
              // endpoint answers POST/OPTIONS but does not allow credentials,
              // and a JSON content type would trigger a preflight that fails.
              const blob = new Blob([body], { type: 'text/plain;charset=UTF-8' });
              if (navigator.sendBeacon(endpoint(), blob)) return;
            }
          } catch {}
          try {
            fetch(endpoint(), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body,
              keepalive: true,
              mode: 'cors',
              credentials: 'omit'
            }).catch(() => {});
          } catch {}
        }
        let pageviewSent = false;
        function sendPageview() {
          if (pageviewSent || !analyticsAllowed()) return;
          pageviewSent = true;
          send({
            path: window.location.pathname,
            referrer: document.referrer || '',
            visitor_id: identifier(localStorage, VISITOR_KEY),
            session_id: identifier(sessionStorage, SESSION_KEY),
            event_type: 'pageview',
            host: window.location.host
          });
        }
        function track(eventType, detail) {
          if (!analyticsAllowed()) return;
          if (eventType === 'pageview') {
            sendPageview();
            return;
          }
          const extra = detail && typeof detail === 'object' ? detail : {};
          send({
            path: typeof extra.path === 'string' && extra.path ? extra.path : window.location.pathname,
            referrer: typeof extra.referrer === 'string' && extra.referrer ? extra.referrer : document.referrer || '',
            visitor_id: identifier(localStorage, VISITOR_KEY),
            session_id: identifier(sessionStorage, SESSION_KEY),
            event_type: eventType,
            host: window.location.host
          });
        }
        window.AstrevaTracking = { track };
        sendPageview();
        // Consent may arrive after this page loaded: flush the pending page view
        // (and write the identifiers) as soon as analytics is accepted.
        window.addEventListener('astreva:cookie-consent', (event) => {
          const detail = event && event.detail;
          if (detail && detail.analytics === true) sendPageview();
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    {isIndexable && <meta name="baiduspider" content="index, follow" />}
    <meta name="theme-color" content="#0a4d8c" />
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {verification.baidu && <meta name="baidu-site-verification" content={verification.baidu} />}
    {verification.so360 && <meta name="360-site-verification" content={verification.so360} />}
    {verification.sogou && <meta name="sogou_site_verification" content={verification.sogou} />}
    {verification.yandex && <meta name="yandex-verification" content={verification.yandex} />}
    {content.site.logoUrl && <link rel="icon" href={content.site.logoUrl} />}
    {content.site.logoUrl && <link rel="apple-touch-icon" href={content.site.logoUrl} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    {isIndexable && hreflangAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    {isIndexable && <link rel="alternate" hreflang="x-default" href={absoluteUrl(localePath(DEFAULT_LOCALE, basePath))} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={content.site.brandName} />
    <meta property="og:locale" content={ogLocale} data-astreva-og-locale />
    {alternateLocales.map((alternate) => <meta property="og:locale:alternate" content={OG_LOCALES[alternate]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && new URL(image).protocol === 'https:' && <meta property="og:image:secure_url" content={image} />}
    {image && <meta property="og:image:alt" content={`${title} - ${content.site.brandName}`} />}
    {isLogoImage && <meta property="og:image:width" content="512" />}
    {isLogoImage && <meta property="og:image:height" content="512" />}
    {isLogoImage && <meta property="og:image:type" content="image/png" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && <meta name="twitter:image:alt" content={`${title} - ${content.site.brandName}`} />}
    {structuredData.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <LanguageController
      apiBase={PUBLIC_CONTENT_API_URL}
      locale={locale}
      availableLocales={availableLocales}
      switchPaths={switchPaths}
    />
    <div class="min-h-screen bg-white font-sans selection:bg-blue-200 selection:text-blue-900">
      <Navbar
        client:only="react"
        site={content.site}
        categories={content.categories}
        products={content.products}
        currentPath={path}
        locale={locale}
      />
      <main>
        <slot />
      </main>
      <footer id="site-footer" class="bg-slate-900 text-white pt-16 pb-8 scroll-mt-24">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
          <div>
            <div class="flex items-center gap-2 mb-6">
              {content.site.logoUrl ? (
                <img src={content.site.logoUrl} alt={footer.logoAlt} class="w-10 h-10 rounded-full object-cover bg-white shadow-sm ring-1 ring-blue-400/30" />
              ) : (
                <span role="img" aria-label={footer.logoAlt} class="grid h-10 w-10 place-items-center rounded-full bg-white text-sm font-black text-[#0a4d8c] shadow-sm ring-1 ring-blue-400/30">{content.site.brandName.slice(0, 1)}</span>
              )}
              <span class="text-2xl font-bold tracking-wide">{content.site.brandName}</span>
            </div>
            <p class="text-gray-400 text-sm mb-6 leading-relaxed">
              {footer.description}
            </p>
          </div>
          <div>
            <h4 class="text-lg font-semibold mb-6">{footer.quickLinksTitle}</h4>
            <ul class="space-y-3 text-gray-400 text-sm">
              {footer.quickLinks.filter((link) => link.href !== '/projects/').map((link) => <li><a href={localizeHref(locale, link.href)} class="hover:text-blue-400 transition-colors">{link.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h4 class="text-lg font-semibold mb-6">{footer.supportTitle}</h4>
            <ul class="space-y-3 text-gray-400 text-sm">
              {footer.supportLinks.map((link) => <li><a href={localizeHref(locale, link.href)} class="hover:text-blue-400 transition-colors">{link.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h4 class="text-lg font-semibold mb-6">{footer.socialTitle}</h4>
            <div class="flex flex-wrap gap-4">
              {Object.entries(content.site.socialLinks).filter(([, url]) => Boolean(url)).map(([name, url]) => (
                <a href={url as string} class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-blue-600 transition-colors uppercase text-xs font-bold" aria-label={name}>
                  {content.site.socialIcons?.[name] || name.slice(0, 1)}
                </a>
              ))}
              {Object.values(content.site.socialLinks).filter(Boolean).length === 0 && (
                <span class="text-gray-500 text-sm">{footer.socialEmptyText}</span>
              )}
            </div>
          </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
          <p>{content.site.copyright}</p>
          <div class="flex gap-6">
            <a href={localePath(locale, '/privacy/')} class="hover:text-gray-300 transition-colors">{footer.privacyLabel}</a>
            <a href={localePath(locale, '/agreement/')} class="hover:text-gray-300 transition-colors">{footer.agreementLabel}</a>
            <button
              type="button"
              data-cookie-settings
              aria-haspopup="dialog"
              class="hover:text-gray-300 transition-colors"
            >
              {content.site.cookie.settingsLabel || 'Cookie settings'}
            </button>
          </div>
        </div>
      </footer>
      <ChatWidget client:only="react" serviceBridgeUrl={content.site.serviceBridgeUrl} chat={content.site.chat} lang={locale} />
      <CookieConsent client:only="react" cookie={content.site.cookie} privacyHref={localePath(locale, '/privacy/')} />
    </div>
  </body>
</html>
