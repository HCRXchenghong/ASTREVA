---
import CategoryView from '../../../views/CategoryView.astro';
import { getContent } from '../../../lib/content';

export async function getStaticPaths() {
  const content = await getContent('zh-CN');
  return content.categories.map((category) => ({ params: { categorySlug: category.slug }, props: { category } }));
}

const content = await getContent('zh-CN');
const { category } = Astro.props;
---

<CategoryView content={content} locale="zh-CN" category={category} />
