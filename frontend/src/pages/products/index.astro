---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, productsForCategory } from '../../lib/content';

const content = await getContent();
const productCenter = content.productCenter;
const categories = [...content.categories].sort((a, b) => a.sortOrder - b.sortOrder);
const firstCategory = categories[0];
const categoryCtaIcon = productCenter.categoryPage.categoryCtaIcon || '→';
const catalog = categories.map((category) => ({
  category,
  products: productsForCategory(content, category.slug).sort((a, b) => a.sortOrder - b.sortOrder).slice(0, 4)
}));
---

<BaseLayout content={content} seo={productCenter.seo} path="/products/">
  <div class="min-h-screen w-full bg-[#f6f8fa] pt-24">
    <section class="relative min-h-[280px] overflow-hidden border-b border-white/10 bg-[#071a31] text-white md:min-h-[320px]">
      {productCenter.hero.backgroundImage && (
        <div
          class="absolute inset-y-0 right-0 w-full bg-cover bg-center opacity-65 md:w-[62%]"
          style={`background-image:url('${productCenter.hero.backgroundImage}')`}
        ></div>
      )}
      <div class="absolute inset-0 bg-[linear-gradient(90deg,#071a31_0%,#071a31_38%,rgba(7,26,49,0.78)_62%,rgba(7,26,49,0.28)_100%)]"></div>
      <div class="relative z-10 mx-auto flex min-h-[280px] max-w-7xl items-center px-6 py-14 md:min-h-[320px]">
        <div class="max-w-2xl">
          <p class="text-xs font-black uppercase tracking-[0.22em] text-[#d7a83d]">Product Center</p>
          <h1 class="mt-4 text-4xl font-black tracking-tight md:text-6xl">{productCenter.hero.title}</h1>
          <p class="mt-5 max-w-xl text-base leading-8 text-slate-200 md:text-lg">
            按产品类型快速查找专业不锈钢排水产品与系统组件。
          </p>
        </div>
      </div>
    </section>

    <section id="product-categories" class="scroll-mt-24 py-12 md:py-16">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mb-7 flex items-end justify-between gap-6 border-b border-[#d8dee7] pb-5">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.2em] text-[#b88923]">Product Categories</p>
            <h2 class="mt-2 text-3xl font-black text-[#172033]">产品分类</h2>
          </div>
          <p class="hidden max-w-lg text-right text-sm leading-7 text-[#667085] md:block">选择左侧产品体系，查看对应系列产品与组件。</p>
        </div>

        <div class="grid items-start gap-7 lg:grid-cols-[250px_minmax(0,1fr)]">
          <aside class="overflow-hidden border border-[#d8dee7] bg-white" style="border-radius:var(--radius-ui)" aria-label="产品分类">
            {categories.map((category, index) => (
              <button
                type="button"
                class="catalog-trigger"
                data-category-trigger={category.slug}
                aria-controls={`catalog-${category.slug}`}
                aria-selected={category.slug === firstCategory?.slug ? 'true' : 'false'}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{category.name}</strong>
              </button>
            ))}
          </aside>

          <div>
            {catalog.map(({ category, products }) => (
              <section
                id={`catalog-${category.slug}`}
                data-category-panel={category.slug}
                class={category.slug === firstCategory?.slug ? '' : 'hidden'}
              >
                <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <h3 class="text-2xl font-black text-[#172033] md:text-3xl">{category.name}</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-7 text-[#667085]">{category.description}</p>
                  </div>
                  <a href={`/products/${category.slug}/`} class="inline-flex shrink-0 items-center gap-2 text-sm font-black text-[#0a66c2] hover:text-[#084b8c]">
                    查看全部 <span aria-hidden="true">{categoryCtaIcon}</span>
                  </a>
                </div>

                {products.length > 0 ? (
                  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    {products.map((product) => (
                      <a
                        href={`/products/${product.categorySlug}/${product.slug}/`}
                        class="group overflow-hidden border border-[#d8dee7] bg-white shadow-[0_10px_28px_rgba(15,32,52,0.05)] transition-all duration-300 hover:-translate-y-1 hover:border-[#9fb7d1] hover:shadow-[0_16px_36px_rgba(15,32,52,0.10)]"
                        style="border-radius:var(--radius-ui)"
                      >
                        <div class="aspect-[16/8.5] overflow-hidden bg-slate-100">
                          <img src={product.coverImage} alt={product.name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                        </div>
                        <div class="flex items-start justify-between gap-5 p-5 md:p-6">
                          <div>
                            <h4 class="text-xl font-black text-[#172033] transition-colors group-hover:text-[#0a5ca8]">{product.name}</h4>
                            <p class="mt-2 line-clamp-2 text-sm leading-6 text-[#667085]">{product.summary}</p>
                          </div>
                          <span class="mt-1 shrink-0 text-xl text-[#0a66c2] transition-transform group-hover:translate-x-1" aria-hidden="true">{categoryCtaIcon}</span>
                        </div>
                      </a>
                    ))}
                  </div>
                ) : (
                  <div class="border border-dashed border-[#cfd7e2] bg-white p-10 text-center text-sm text-[#667085]" style="border-radius:var(--radius-ui)">
                    该分类的系列产品正在整理中。
                  </div>
                )}
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-category-trigger]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-category-panel]'));

    const activateCategory = (slug: string) => {
      triggers.forEach((trigger) => trigger.setAttribute('aria-selected', String(trigger.dataset.categoryTrigger === slug)));
      panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.categoryPanel !== slug));
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => activateCategory(trigger.dataset.categoryTrigger || ''));
    });
  </script>

  <style>
    .catalog-trigger {
      align-items: center;
      background: #fff;
      border-bottom: 1px solid #e1e6ed;
      color: #303a4b;
      display: grid;
      gap: 14px;
      grid-template-columns: 34px 1fr;
      min-height: 68px;
      padding: 0 20px;
      position: relative;
      text-align: left;
      transition: background-color 0.2s ease, color 0.2s ease;
      width: 100%;
    }
    .catalog-trigger:last-child { border-bottom: 0; }
    .catalog-trigger::before {
      background: #0a66c2;
      bottom: 0;
      content: '';
      left: 0;
      opacity: 0;
      position: absolute;
      top: 0;
      width: 4px;
    }
    .catalog-trigger span {
      color: #9aa5b4;
      font-size: 12px;
      font-weight: 900;
    }
    .catalog-trigger strong { font-size: 15px; font-weight: 900; }
    .catalog-trigger:hover,
    .catalog-trigger[aria-selected='true'] {
      background: #edf5ff;
      color: #0a4d8c;
    }
    .catalog-trigger[aria-selected='true']::before { opacity: 1; }
    .catalog-trigger[aria-selected='true'] span { color: #0a66c2; }
  </style>
</BaseLayout>
