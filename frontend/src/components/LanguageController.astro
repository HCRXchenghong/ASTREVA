---
import type { SiteLocale } from '../lib/i18n';

type Props = {
  apiBase: string;
  locale: SiteLocale;
  availableLocales: SiteLocale[];
  /** locale -> equivalent path on the current page (built by BaseLayout). */
  switchPaths: Record<string, string>;
};

const { apiBase, availableLocales, switchPaths } = Astro.props;
---

<script is:inline src="/assets/astreva-language.js" data-api-base={apiBase} data-locales={JSON.stringify(availableLocales)} data-paths={JSON.stringify(switchPaths)} data-astreva-language></script>

<style is:global>
  html[dir='rtl'] body {
    direction: rtl;
    text-align: right;
  }
</style>
