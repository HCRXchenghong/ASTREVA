---
import type { SiteContent } from '../lib/types';

type Props = { content: SiteContent; apiBase: string };
const { content, apiBase } = Astro.props;
const bootstrap = JSON.stringify({ source: content, apiBase }).replace(/</g, '\\u003c');
const localization = content.site.localization;
---

<div class="site-language-control" id="astreva-language-control" dir="ltr">
  <span id="astreva-language-state" aria-live="polite"></span>
</div>
<script id="astreva-language-bootstrap" type="application/json" set:html={bootstrap}></script>
<script is:inline>
  (() => {
    const supported = new Set(['zh-CN', 'en', 'ar']);
    const storageKey = 'astreva-site-locale';
    const control = document.querySelector('#astreva-language-control');
    const stateLabel = document.querySelector('#astreva-language-state');
    const bootstrap = JSON.parse(document.querySelector('#astreva-language-bootstrap').textContent || '{}');
    const sourceContent = bootstrap.source;
    const apiBase = String(bootstrap.apiBase || '').replace(/\/$/, '');
    const localeCache = new Map([['zh-CN', sourceContent]]);
    const textSources = new WeakMap();
    const textNodes = new Set();
    const attributeSources = new WeakMap();
    const attributeElements = new Set();
    const translatedAttributes = ['alt', 'title', 'placeholder', 'aria-label', 'content'];
    let currentLocale = 'zh-CN';
    let currentDictionary = new Map();
    let applying = false;

    function leafValues(value, path = '', output = new Map()) {
      if (Array.isArray(value)) value.forEach((item, index) => leafValues(item, path ? `${path}.${index}` : String(index), output));
      else if (value && typeof value === 'object') Object.entries(value).forEach(([key, item]) => leafValues(item, path ? `${path}.${key}` : key, output));
      else if (typeof value === 'string') output.set(path, value);
      return output;
    }

    function dictionaryFor(target) {
      const source = leafValues(sourceContent);
      const translated = leafValues(target);
      const dictionary = new Map();
      for (const [path, value] of source) {
        const next = translated.get(path);
        if (next != null && next !== value) dictionary.set(value, next);
      }
      return dictionary;
    }

    function excluded(element) {
      return !element || Boolean(element.closest('#astreva-language-control,[data-lang-switch-root],script,style,noscript,code,pre,textarea,select'));
    }

    function translatedValue(source) {
      const trimmed = String(source || '').trim();
      if (!trimmed || !currentDictionary.has(trimmed)) return source;
      return String(source).replace(trimmed, currentDictionary.get(trimmed));
    }

    function trackElement(element) {
      if (excluded(element)) return;
      let sources = attributeSources.get(element);
      if (!sources) {
        sources = new Map();
        attributeSources.set(element, sources);
        attributeElements.add(element);
      }
      for (const name of translatedAttributes) {
        if (!element.hasAttribute?.(name)) continue;
        if (!sources.has(name)) sources.set(name, element.getAttribute(name));
        const next = currentLocale === 'zh-CN' ? sources.get(name) : translatedValue(sources.get(name));
        if (element.getAttribute(name) !== next) element.setAttribute(name, next);
      }
    }

    function trackText(node) {
      if (excluded(node.parentElement)) return;
      if (!textSources.has(node)) {
        textSources.set(node, node.nodeValue || '');
        textNodes.add(node);
      }
      const source = textSources.get(node);
      const next = currentLocale === 'zh-CN' ? source : translatedValue(source);
      if (node.nodeValue !== next) node.nodeValue = next;
    }

    function scan(root = document.documentElement) {
      applying = true;
      try {
        if (root.nodeType === Node.TEXT_NODE) trackText(root);
        else if (root.nodeType === Node.ELEMENT_NODE) {
          trackElement(root);
          const walker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
          let node;
          while ((node = walker.nextNode())) node.nodeType === Node.TEXT_NODE ? trackText(node) : trackElement(node);
        }
      } finally { applying = false; }
    }

    function applyTracked() {
      applying = true;
      try {
        for (const node of textNodes) {
          if (!node.isConnected) { textNodes.delete(node); continue; }
          const source = textSources.get(node) || '';
          node.nodeValue = currentLocale === 'zh-CN' ? source : translatedValue(source);
        }
        for (const element of attributeElements) {
          if (!element.isConnected) { attributeElements.delete(element); continue; }
          const sources = attributeSources.get(element);
          for (const [name, source] of sources || []) element.setAttribute(name, currentLocale === 'zh-CN' ? source : translatedValue(source));
        }
      } finally { applying = false; }
    }

    function setDocumentLocale(locale) {
      document.documentElement.lang = locale;
      document.documentElement.dir = locale === 'ar' ? 'rtl' : 'ltr';
      window.dispatchEvent(new CustomEvent('astreva:locale', { detail: locale }));
      control.dataset.locale = locale;
    }

    async function contentFor(locale) {
      if (localeCache.has(locale)) return localeCache.get(locale);
      const response = await fetch(`${apiBase}/site-admin-api/public-content?locale=${encodeURIComponent(locale)}`, { credentials: 'omit' });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error?.message || sourceContent.site.localization.unavailableText);
      localeCache.set(locale, payload.data);
      return payload.data;
    }

    async function switchLocale(locale, manual = false) {
      if (!supported.has(locale)) locale = 'zh-CN';
      stateLabel.textContent = sourceContent.site.localization.switchingText;
      stateLabel.className = '';
      try {
        const target = await contentFor(locale);
        currentLocale = locale;
        currentDictionary = locale === 'zh-CN' ? new Map() : dictionaryFor(target);
        setDocumentLocale(locale);
        applyTracked();
        scan(document.documentElement);
        if (manual) localStorage.setItem(storageKey, locale);
        stateLabel.textContent = '';
      } catch (error) {
        currentLocale = 'zh-CN';
        currentDictionary = new Map();
        setDocumentLocale('zh-CN');
        applyTracked();
        stateLabel.textContent = sourceContent.site.localization.unavailableText;
        stateLabel.className = 'error';
        stateLabel.title = error?.message || String(error);
      }
    }

    const observer = new MutationObserver((mutations) => {
      if (applying) return;
      for (const mutation of mutations) {
        if (mutation.type === 'characterData') trackText(mutation.target);
        mutation.addedNodes?.forEach((node) => scan(node));
      }
    });
    scan(document.documentElement);
    observer.observe(document.documentElement, { subtree: true, childList: true, characterData: true });
    window.AstrevaLanguage = {
      switch: (locale) => switchLocale(locale, true),
      get: () => currentLocale
    };

    const saved = localStorage.getItem(storageKey);
    if (supported.has(saved)) switchLocale(saved, false);
    else fetch(`${apiBase}/site-admin-api/public-locale`, { credentials: 'omit' })
      .then((response) => response.ok ? response.json() : null)
      .then((payload) => switchLocale(payload?.data?.locale || 'zh-CN', false))
      .catch(() => switchLocale('zh-CN', false));
  })();
</script>

<style is:global>
  .site-language-control{position:fixed;z-index:45;top:106px;right:18px;display:flex;align-items:center;gap:8px;padding:8px 12px;border:2px solid #0a66c2;border-radius:999px;background:#fff;box-shadow:0 12px 32px rgba(10,77,140,.25),0 2px 6px rgba(15,23,42,.10);animation:astreva-lang-pop .45s ease .25s both}
  @keyframes astreva-lang-pop{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
  .site-language-control{pointer-events:none;top:106px;right:18px;display:block;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;animation:none}
  .site-language-control span{display:none;font-size:12px;font-weight:700;color:#0a4d8c;background:rgba(255,255,255,.97);border:1px solid #0a66c2;padding:4px 12px;border-radius:999px;box-shadow:0 8px 24px rgba(10,77,140,.25)}
  .site-language-control span:not(:empty){display:inline-block}
  .site-language-control span.error{color:#b42318}
  html[dir="rtl"] body{direction:rtl;text-align:right}
  html[dir="rtl"] .site-language-control{direction:ltr}
  @media(max-width:767px){.site-language-control{top:104px;right:12px}}
</style>
